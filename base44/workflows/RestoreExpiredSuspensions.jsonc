{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "restore_expired_suspensions",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "restore": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "restoreExpiredSuspensions"
          },
          "then": "end",
          "x-base44": {
            "title": "Restore expired suspensions",
            "description": "Auto-restore users past their 72h window"
          }
        }
      }
    ]
  },
  "name": "Restore Expired Suspensions",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 * * * *",
      "one_time_date": null,
      "timezone": "Europe/Paris",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "description": "Hourly safety net: restores users whose temporary suspension window has passed."
}