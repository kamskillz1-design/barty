{
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 9 * * *",
      "one_time_date": null,
      "timezone": "Europe/Madrid",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "description": "Daily check that nudges both sides of idle accepted trades by email",
  "name": "Trade Nudges",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "trade_nudges",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "nudge_idle": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "nudgeIdleTrades",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Nudge idle trades",
            "description": "Email both sides of idle accepted trades"
          }
        }
      }
    ]
  }
}