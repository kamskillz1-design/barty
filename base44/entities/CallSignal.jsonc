{
  "name": "CallSignal",
  "type": "object",
  "properties": {
    "call_id": {
      "type": "string",
      "description": "Unique id for the call session this signal belongs to"
    },
    "trade_id": {
      "type": "string",
      "description": "Trade this call is part of"
    },
    "from_user_id": {
      "type": "string",
      "description": "User sending this signal"
    },
    "to_user_id": {
      "type": "string",
      "description": "Intended recipient of this signal"
    },
    "participants": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Both trade participant user ids [proposer_id, receiver_id] used for RLS"
    },
    "kind": {
      "type": "string",
      "enum": [
        "offer",
        "answer",
        "ice",
        "decline",
        "end"
      ],
      "description": "Signal type"
    },
    "mode": {
      "type": "string",
      "enum": [
        "video",
        "voice"
      ],
      "description": "Call mode"
    },
    "payload": {
      "type": "string",
      "description": "JSON-stringified SDP or ICE candidate"
    }
  },
  "required": [
    "call_id",
    "trade_id",
    "from_user_id",
    "to_user_id",
    "participants",
    "kind",
    "mode"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.participants": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.participants": {
            "$in": [
              "{{user.id}}"
            ]
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}