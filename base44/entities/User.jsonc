{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "user"
      ]
    },
    "preferred_language": {
      "type": "string",
      "description": "UI language preference (ISO 639-1 code); any world language is supported"
    },
    "country": {
      "type": "string",
      "description": "User's country"
    },
    "city": {
      "type": "string",
      "description": "User's city or town"
    },
    "town": {
      "type": "string",
      "description": "User's village or local area"
    },
    "avatar_url": {
      "type": "string",
      "description": "Profile picture URL"
    },
    "bio": {
      "type": "string",
      "description": "Short profile bio"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "suspended",
        "banned"
      ],
      "default": "active",
      "description": "Account moderation status. 'suspended' = temporary (auto-restores at suspended_until), 'banned' = permanent."
    },
    "suspended_until": {
      "type": "string",
      "format": "date-time",
      "description": "When a temporary suspension ends. Cleared on restore."
    }
  },
  "required": [
    "role"
  ]
}