{
  "name": "UserFlag",
  "type": "object",
  "properties": {
    "reported_user_id": {
      "type": "string",
      "description": "User being reported"
    },
    "reporter_id": {
      "type": "string",
      "description": "User who reported (snapshot; created_by_id also holds this)"
    },
    "reason": {
      "type": "string",
      "enum": [
        "spam",
        "inappropriate",
        "misleading",
        "other"
      ],
      "description": "Reason for the report"
    },
    "note": {
      "type": "string",
      "description": "Optional extra details from the reporter"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "hidden",
        "restored",
        "removed"
      ],
      "default": "open",
      "description": "Moderation status of the flag"
    }
  },
  "required": [
    "reported_user_id",
    "reporter_id",
    "reason"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}