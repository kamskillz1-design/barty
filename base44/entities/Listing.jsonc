create table if not exists public.listings (
  id uuid primary key default gen_random_uuid(),

  title text not null,
  description text,

  have_exchange_type text not null
    check (have_exchange_type in ('goods', 'services', 'digital')),
  have_category text not null,
  have_subcategory text,

  want_exchange_type text
    check (
      want_exchange_type is null
      or want_exchange_type in ('goods', 'services', 'digital')
    ),
  want_category text,
  want_subcategory text,
  want_title text,
  want_description text,

  is_open_to_anything boolean not null default false,

  exchange_location text not null
    check (exchange_location in ('local', 'national', 'international', 'online')),

  tags text[] not null default '{}',

  country text,
  city text,
  town text,
  language text,

  baseline_value integer not null default 50,

  image_urls text[] not null default '{}',

  status text not null default 'available'
    check (status in ('available', 'reserved', 'traded', 'hidden')),

  offering_user_id uuid not null
    references public.profiles(id) on delete cascade,

  lat double precision,
  lng double precision,

  last_confirmed_date timestamptz,
  stale_prompted_date timestamptz,

  created_at timestamptz not null default now(),
  updated_at timestamptz not null default now(),

  constraint listings_want_details_required
    check (
      is_open_to_anything = true
      or (
        want_exchange_type is not null
        and want_category is not null
      )
    )
);

create index if not exists listings_offering_user_id_idx
on public.listings (offering_user_id);

create index if not exists listings_status_idx
on public.listings (status);

create index if not exists listings_exchange_location_idx
on public.listings (exchange_location);

create index if not exists listings_have_category_idx
on public.listings (have_category);

create index if not exists listings_want_category_idx
on public.listings (want_category);

create index if not exists listings_location_idx
on public.listings (country, city, town);

alter table public.listings enable row level security;

grant select on public.listings to anon, authenticated;
grant insert, update, delete on public.listings to authenticated;

create policy "Available listings are publicly viewable"
on public.listings
for select
using (
  status in ('available', 'reserved', 'traded')
  or (select auth.uid()) = offering_user_id
);

create policy "Users can create their own listings"
on public.listings
for insert
to authenticated
with check ((select auth.uid()) = offering_user_id);

create policy "Users can update their own listings"
on public.listings
for update
to authenticated
using ((select auth.uid()) = offering_user_id)
with check ((select auth.uid()) = offering_user_id);

create policy "Users can delete their own listings"
on public.listings
for delete
to authenticated
using ((select auth.uid()) = offering_user_id);

drop trigger if exists set_listings_updated_at on public.listings;

create trigger set_listings_updated_at
before update on public.listings
for each row
execute function public.set_updated_at();
