{
  "name": "Listing",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Title of the listing \u2014 short label for the HAVING item"
    },
    "description": {
      "type": "string",
      "description": "Detailed description of what is offered"
    },
    "have_exchange_type": {
      "type": "string",
      "enum": [
        "goods",
        "services",
        "digital"
      ],
      "description": "Top-level exchange type of the HAVE side (what is offered)"
    },
    "have_category": {
      "type": "string",
      "description": "V1 category id on the HAVE side"
    },
    "have_subcategory": {
      "type": "string",
      "description": "Free-form subcategory label on the HAVE side"
    },
    "want_exchange_type": {
      "type": "string",
      "enum": [
        "goods",
        "services",
        "digital"
      ],
      "description": "Top-level exchange type of the WANT side (what is wanted in return). Empty when is_open_to_anything is true."
    },
    "want_category": {
      "type": "string",
      "description": "V1 category id on the WANT side. Empty when is_open_to_anything is true."
    },
    "want_subcategory": {
      "type": "string",
      "description": "Free-form subcategory label on the WANT side. Empty when is_open_to_anything is true."
    },
    "is_open_to_anything": {
      "type": "boolean",
      "default": false,
      "description": "When true, the owner accepts any fair exchange and the WANT fields are ignored."
    },
    "exchange_location": {
      "type": "string",
      "enum": [
        "local",
        "national",
        "international",
        "online"
      ],
      "description": "Where the exchange can take place"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Free-form tags to power search and matching"
    },
    "country": {
      "type": "string",
      "description": "Country where the listing owner is based"
    },
    "city": {
      "type": "string",
      "description": "City or town"
    },
    "town": {
      "type": "string",
      "description": "Village or local area"
    },
    "language": {
      "type": "string",
      "description": "Language the listing owner communicates in"
    },
    "baseline_value": {
      "type": "integer",
      "description": "Internal neutral integer used for fairness matching \u2014 never displayed to users",
      "default": 50
    },
    "image_urls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Image URLs for the listing"
    },
    "status": {
      "type": "string",
      "enum": [
        "available",
        "reserved",
        "traded"
      ],
      "default": "available",
      "description": "Availability status"
    },
    "offering_user_id": {
      "type": "string",
      "description": "User who owns this listing"
    }
  },
  "required": [
    "title",
    "have_exchange_type",
    "have_category",
    "exchange_location",
    "baseline_value"
  ]
}