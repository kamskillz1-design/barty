{
  "name": "UserBlock",
  "type": "object",
  "properties": {
    "blocker_id": {
      "type": "string",
      "description": "User who initiated the block (A)."
    },
    "blocked_id": {
      "type": "string",
      "description": "User who is blocked (B). B can no longer see A's profile or listings, or message/call A."
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "false once unblocked. Records are retained (never deleted) so block/unblock history stays for accountability."
    },
    "unblocked_date": {
      "type": "string",
      "format": "date-time",
      "description": "When the block was lifted, if active=false."
    }
  },
  "required": [
    "blocker_id",
    "blocked_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.blocked_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}